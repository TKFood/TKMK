<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="07/13/2026 11:14:36" ReportInfo.Modified="07/13/2026 14:11:24" ReportInfo.CreatorVersion="2017.4.1.0">
  <Dictionary>
    <MsSqlDataConnection Name="Connection" ConnectionString="rijcmlqHwzMSgwTFaHpjtG3vsOj8Zy6q+uhwpDsytgWqwZQZyEQUQyQ022aWUGqU90pHzzNS8V+op55d8q+MyIM1gh0M9zlGOgK4zWs8Nahyki0xHW6v1SoNjLsQ40hUEIevZodc4nZn1VMr9PyrOeyOFQcW49yN37Wommt8wACdM4FKHAeO5qqwIh8UI3n9QTXxqWwafBK/MA1HCJxlSqyc/WVhw==">
      <TableDataSource Name="Table" DataType="System.Int32" Enabled="true" SelectCommand="SELECT &#13;&#10;     TEMP.HRS AS '入場時間'&#13;&#10;    ,SUM(TEMP.CARNUM) AS '團車來車數'&#13;&#10;    ,SUM(ISNULL(P.TOTALTA026, 0)) AS '團車銷售總金額'&#13;&#10;    ,SUM(ISNULL(P.FC_MONEY, 0)) AS '方城市總金額'&#13;&#10;    ,SUM(ISNULL(P.YWM_MONEY, 0)) AS '硯微墨總金額'&#13;&#10;    -- 平均金額計算（加入除以 0 保護）&#13;&#10;    ,CASE &#13;&#10;        WHEN SUM(TEMP.CARNUM) = 0 THEN 0 &#13;&#10;        ELSE SUM(ISNULL(P.TOTALTA026, 0)) / SUM(TEMP.CARNUM) &#13;&#10;     END AS '團車平均銷售金額'&#13;&#10;    ,CASE &#13;&#10;        WHEN SUM(TEMP.CARNUM) = 0 THEN 0 &#13;&#10;        ELSE SUM(ISNULL(P.FC_MONEY, 0)) / SUM(TEMP.CARNUM) &#13;&#10;     END AS '方城市平均銷售金額'&#13;&#10;    ,CASE &#13;&#10;        WHEN SUM(TEMP.CARNUM) = 0 THEN 0 &#13;&#10;        ELSE SUM(ISNULL(P.YWM_MONEY, 0)) / SUM(TEMP.CARNUM) &#13;&#10;     END AS '硯微墨平均銷售金額'&#13;&#10;FROM &#13;&#10;(&#13;&#10;    -- 內層 A：只負責乾淨地取出團車資料，並轉換日期與小時&#13;&#10;    SELECT&#13;&#10;         CONVERT(VARCHAR(8), [GROUPSTARTDATES], 112) AS [GROUP_DATE]&#13;&#10;        ,DATEPART(HOUR, [GROUPSTARTDATES]) AS [HRS]&#13;&#10;        ,[CARNUM]  &#13;&#10;        ,[EXCHANACOOUNT] &#13;&#10;    FROM [TKMK].[dbo].[GROUPSALES] WITH(NOLOCK)&#13;&#10;    -- 優化 1：改用標準時間範圍比對，釋放 [GROUPSTARTDATES] 索引效能&#13;&#10;    WHERE CONVERT(NVARCHAR,[GROUPSTARTDATES],112) &gt;= '20260706' &#13;&#10;AND  CONVERT(NVARCHAR,[GROUPSTARTDATES],112)&lt;= '20260713' &#13;&#10;) AS TEMP&#13;&#10;-- 優化 2：將原本 3 個子查詢，整合成一個高效的 LEFT JOIN 統計表&#13;&#10;LEFT JOIN (&#13;&#10;    SELECT &#13;&#10;         TA001 -- 日期&#13;&#10;        ,TA008 -- 帳號&#13;&#10;        ,SUM(TA026) AS TOTALTA026 -- 總金額&#13;&#10;        ,SUM(CASE WHEN TA002 = '106701' THEN TA026 ELSE 0 END) AS FC_MONEY  -- 方城市金額&#13;&#10;        ,SUM(CASE WHEN TA002 = '106702' THEN TA026 ELSE 0 END) AS YWM_MONEY -- 硯微墨金額&#13;&#10;    FROM [TK].dbo.POSTA WITH(NOLOCK)&#13;&#10;    WHERE TA001 BETWEEN '20260706' AND '20260713'&#13;&#10;    GROUP BY TA001, TA008&#13;&#10;) AS P ON P.TA001 = TEMP.GROUP_DATE AND P.TA008 = TEMP.EXCHANACOOUNT&#13;&#10;GROUP BY TEMP.HRS&#13;&#10;ORDER BY TEMP.HRS;">
        <Column Name="團車銷售總金額" DataType="System.Int32"/>
        <Column Name="團車來車數" DataType="System.Int32"/>
        <Column Name="方城市總金額" DataType="System.Decimal"/>
        <Column Name="硯微墨總金額" DataType="System.Decimal"/>
        <Column Name="團車平均銷售金額" DataType="System.Decimal"/>
        <Column Name="方城市平均銷售金額" DataType="System.Decimal"/>
        <Column Name="硯微墨平均銷售金額" DataType="System.Decimal"/>
        <Column Name="入場時間" DataType="System.Int32"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Parameter Name="P1" DataType="System.String"/>
    <Parameter Name="P2" DataType="System.String"/>
  </Dictionary>
