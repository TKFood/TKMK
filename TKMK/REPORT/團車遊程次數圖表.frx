      <TableDataSource Name="Table" DataType="System.Int32" Enabled="true" SelectCommand="SELECT  &#13;&#10;[CARNAME] AS '車名'&#13;&#10;,[CARNO] AS '車號'&#13;&#10;,[PLAYPROCESS] AS '去程回程'   &#13;&#10;,COUNT([CARNO])  AS '遊程次數'&#13;&#10;,AVG([SALESMMONEYS]) AS '平均消費金額'&#13;&#10;,SUM([SALESMMONEYS]) AS '加總消費金額'&#13;&#10;FROM [TKMK].[dbo].[GROUPSALES]&#13;&#10;WHERE 1=1&#13;&#10;AND CONVERT(nvarchar,[CREATEDATES],112)&gt;='20260520'&#13;&#10;AND CONVERT(nvarchar,[CREATEDATES],112)&lt;='20260521'&#13;&#10;AND [STATUS]&lt;&gt;'取消預約'&#13;&#10;GROUP BY [CARNAME],[CARNO],[PLAYPROCESS]&#13;&#10; ORDER BY COUNT([CARNO])  DESC,[CARNAME],[CARNO],[PLAYPROCESS]">
