        <TableRow Name="Row1" Height="18.19" AutoSize="true">
          <TableCell Name="Cell1" Border.Lines="All" Text="品名" HorzAlign="Center" VertAlign="Center"/>
          <TableCell Name="Cell2" Border.Lines="All" Text="品號" HorzAlign="Center" VertAlign="Center"/>
          <TableCell Name="Cell5" Border.Lines="All" Text="[日期]" HorzAlign="Center" VertAlign="Center"/>
        </TableRow>
        <TableRow Name="Row2" Height="18.19" AutoSize="true">
          <TableCell Name="Cell3" Border.Lines="All" Text="[品名]" VertAlign="Center"/>
          <TableCell Name="Cell4" Border.Lines="All" Text="[品號]" VertAlign="Center"/>
          <TableCell Name="Cell6" Border.Lines="All" Text="[當日完銷率 = 當日銷量 / 當日進貨量（不含前期庫存）]" Format="Percent" Format.UseLocale="false" Format.DecimalDigits="2" Format.DecimalSeparator="." Format.GroupSeparator="," Format.PercentSymbol="%" Format.PositivePattern="1" Format.NegativePattern="1" HorzAlign="Right" VertAlign="Center"/>
        </TableRow>
      </MatrixObject>
